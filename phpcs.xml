<?xml version="1.0"?>
<ruleset name="OpenXE">
    <description>OpenXE PHP Coding Standard</description>

    <!-- Show progress -->
    <arg value="p"/>
    <!-- Use colors -->
    <arg name="colors"/>
    <!-- Show sniff codes -->
    <arg value="s"/>

    <!-- PSR-12 Standard -->
    <rule ref="PSR12"/>

    <!-- Paths to check -->
    <file>classes</file>

    <!-- Exclude patterns -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>userdata/*</exclude-pattern>
    <exclude-pattern>www/cache/*</exclude-pattern>
    <exclude-pattern>www/lib/class.*.php</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
</ruleset>
