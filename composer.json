{
  "require": {
    "php": "^8.1",
    "ext-gd": "*",
    "ext-curl": "*",
    "ext-soap": "*",
    "aura/sqlquery": "2.7.1",
    "aws/aws-sdk-php": "3.175.2",
    "ezyang/htmlpurifier": "v4.13.0",
    "fiskaly/fiskaly-sdk-php": "1.2.100",
    "guzzlehttp/guzzle": "^6.5.5",
    "laminas/laminas-mail": "^2.12.5",
    "league/color-extractor": "0.3.2",
    "league/flysystem": "^1.0.70",
    "league/oauth1-client": "v1.9.0",
    "lfkeitel/phptotp": "^1.0",
    "nikic/fast-route": "^1.3",
    "phpmailer/phpmailer": "v6.3.0",
    "psr/log": "^1.0",
    "rakit/validation": "v0.22.3",
    "sabre/dav": "3.2.3",
    "smarty/smarty": "v3.1.39",
    "swiss-payment-slip/swiss-payment-slip": "0.13.0 as 0.11.1",
    "swiss-payment-slip/swiss-payment-slip-fpdf": "0.6.0",
    "tecnickcom/tcpdf": "6.3.5",
    "y0lk/oauth1-etsy": "1.1.0"
  },
  "replace": {
    "itbz/fpdf": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10",
    "phpstan/extension-installer": "^1.3",
    "friendsofphp/php-cs-fixer": "^3.48",
    "squizlabs/php_codesniffer": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "Xentral\\": "classes"
    },
    "classmap": ["www/lib/versandarten/"]
  },
  "config": {
    "platform": {
      "php": "8.1",
      "ext-gd": "8.1"
    },
    "optimize-autoloader": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "audit": {
      "block-insecure": false
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=512M --error-format=table || true",
    "phpstan-strict": "phpstan analyse --memory-limit=512M",
    "phpstan-baseline": "phpstan analyse --memory-limit=512M --generate-baseline",
    "cs-check": "php-cs-fixer fix --dry-run --diff || true",
    "cs-fix": "php-cs-fixer fix",
    "phpcs": "phpcs || true",
    "quality": [
      "@phpstan",
      "@cs-check"
    ],
    "quality-strict": [
      "@phpstan-strict",
      "@cs-check",
      "@phpcs"
    ]
  }
}
